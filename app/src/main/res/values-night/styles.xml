<resources>
    <!-- Dark system theme: WebView then reports prefers-color-scheme: dark, so Claude renders
         its own dark theme instead of the system force-darkening a "light" app. -->
    <style name="AppTheme" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/paper</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
    </style>
</resources>
